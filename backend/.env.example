# =========================================
# Grantum Parser environment template
# Скопируй в .env и заполни локально
# .env НЕ коммитить в git
# =========================================

# home | vps
SERVER_LOCATION=home

# Адрес CDP-браузера
CDP_URL=http://localhost:9222

# Telegram notifier
TELEGRAM_BOT_TOKEN=
# Можно указать несколько chat_id через запятую — уведомления получат все.
TELEGRAM_CHAT_ID=123456789,987654321

# Используется только при SERVER_LOCATION=vps
PUBLIC_BROWSER_URL=

# Сколько ждать действия человека при капче/авторизации
HUMAN_WAIT_SECONDS=600

# =========================================
# LLM для analyzer (OpenAI-совместимый API)
# =========================================
#
# Пул API-ключей (рекомендуется):
# Перечисли ключи через запятую. Если первый ключ упрётся
# в дневной лимит, приложение автоматически возьмёт следующий.
# Минутные лимиты (RPM/TPM) держатся в памяти процесса.
# При 429 от провайдера ключ получает временный cooldown.
LLM_API_KEYS=sk-first,sk-second,sk-third

# Одиночный ключ (устарело, оставлено для обратной совместимости).
# Если LLM_API_KEYS задан, этот параметр игнорируется.
LLM_API_KEY=

LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://api.openai.com/v1

# Лимиты для ОДНОГО LLM-ключа.
# При достижении RPM/TPM ключ уходит в короткий cooldown (5–60 сек).
# При достижении DAILY ключ блокируется до 00:00 UTC и включается следующий.
# 15 запросов в минуту
LLM_RPM_LIMIT=15
# 250 000 токенов в минуту
LLM_TPM_LIMIT=250000
# 500 запросов в день
LLM_DAILY_REQUEST_LIMIT=500

# Сколько секунд ждать освобождения ключа, если все ключи
# временно упёрлись в минутные лимиты. По умолчанию 120.
LLM_KEY_WAIT_SECONDS=120

# =========================================
# Analyzer limits
# =========================================
ANALYZER_MAX_DOM_CHARS=200000
PROFILE_RESCAN_COOLDOWN_SECONDS=3600

# Smart mode limits (умный режим)
# Максимум переходов на detail-страницы за запуск
SMART_MAX_DETAIL_PAGES=100
# Максимум новых дочерних профилей за запуск (перекрывается лимитом из UI)
SMART_MAX_NEW_CHILD_PROFILES=20

# AI-структурирование карточек (smart-режим)
# Включить/выключить обработку raw_text через LLM для структурирования
SMART_STRUCTURING_ENABLED=true
# Сколько карточек отправлять в одном промпте LLM (больше = дешевле, но менее точно)
SMART_STRUCTURING_BATCH_SIZE=5
# Максимум ретраев при невалидном JSON от LLM
SMART_STRUCTURING_MAX_RETRIES=2

# Опционально
# SQLALCHEMY_DATABASE_URI=sqlite:///db.sqlite3

# =========================================
# Доступ к сайту (аутентификация)
# =========================================
#
# Пароль входа в консоль. Если оставить пустым — при первом старте
# будет сгенерирован случайный и напечатан в консоль бекенда.
# Минимум 10 символов.
AUTH_PASSWORD=

# Время жизни сессии: абсолютное и по неактивности (секунды)
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=3600

# Secure-флаг у куки сессии: auto (secure при SERVER_LOCATION=vps) | true | false
# На http://localhost оставь auto. Для продакшена за HTTPS — true.
SESSION_COOKIE_SECURE=auto

# Защита от брутфорса логина
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_BASE_SECONDS=30
AUTH_LOCKOUT_MAX_SECONDS=3600
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=300

# Общий rate limit на /api/* (запросов в минуту с одного IP)
AUTH_API_RATE_LIMIT=240

# Минимальная длина пароля
AUTH_MIN_PASSWORD_LENGTH=10

# Origins фронтенда для CORS (через запятую). С куками нельзя "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173