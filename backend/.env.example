# =========================================
# Grantum Parser environment template
# Скопируй в .env и заполни локально
# .env НЕ коммитить в git
# =========================================

# home | vps
SERVER_LOCATION=home

# Адрес CDP-браузера
CDP_URL=http://localhost:9222

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Используется только при SERVER_LOCATION=vps
PUBLIC_BROWSER_URL=

# Сколько ждать действия человека при капче/авторизации
HUMAN_WAIT_SECONDS=600

# LLM для analyzer
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Analyzer limits
ANALYZER_MAX_DOM_CHARS=200000
PROFILE_RESCAN_COOLDOWN_SECONDS=3600

# Smart mode limits (умный режим)
# Максимум переходов на detail-страницы за запуск
SMART_MAX_DETAIL_PAGES=100
# Максимум новых дочерних профилей за запуск (перекрывается лимитом из UI)
SMART_MAX_NEW_CHILD_PROFILES=20

# Опционально
# SQLALCHEMY_DATABASE_URI=sqlite:///db.sqlite3